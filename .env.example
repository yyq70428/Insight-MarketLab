HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=*
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
# Atlas：mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=...
# 本機 Compose：mongodb://mongo:27017/marketlab，啟動時另加 --profile local-mongo
MONGODB_URI=
MONGODB_DATABASE=marketlab
DATABASE_URL=
POSTGRES_USER=marketlab
POSTGRES_PASSWORD=
POSTGRES_DB=marketlab
DISCORD_WEBHOOK_URL=
ALERTS_ENABLED=false
RAGAS_ENABLED=false
RAGAS_API_KEY=
RAGAS_MODEL=
RAGAS_BASE_URL=
SCAN_SYMBOLS=
# 每日雙 Agent 報告：固定 70 檔（台股 60 + 美股 10），到點依序跑技術面與新聞面並寄出。
# 每檔約 20 秒且含一次 LLM 呼叫，全跑一輪約 25 分鐘，開啟前請確認額度。
DAILY_REPORT_ENABLED=false
DAILY_REPORT_TIME=18:00
DAILY_REPORT_TIMEZONE=Asia/Taipei
# 排程只在這段時間內補跑；重啟時間超過就跳過當天，不會突然觸發整輪。
DAILY_REPORT_WINDOW_MINUTES=120
DAILY_REPORT_WEEKDAYS_ONLY=true
DAILY_REPORT_DELAY=1.5
# 郵件報告裡「點標的跳回 K 線圖」的連結需要絕對網址；留空則報告不帶連結（頁內預覽不受影響）。
PUBLIC_BASE_URL=
# 寄件設定。Gmail 請用應用程式密碼（不是登入密碼），主機 smtp.gmail.com、埠 587。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# 收件者，多筆以逗號分隔。
REPORT_RECIPIENTS=
# Optional: pin pre-existing volumes only when migrating an older installation.
# MARKETLAB_EXISTING_VOLUMES=true
# MARKETLAB_POSTGRES_VOLUME=deploy_postgres_data
# MARKETLAB_MONGO_VOLUME=deploy_mongo_data
